# Copy to .env for local development.
ENVIRONMENT=development
# Host port for the docker-compose database (5433 avoids clashing with a native PostgreSQL).
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lumior:lumior@localhost:5433/lumior
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
# Signs access tokens. Required (at least 32 characters) in staging and production.
SECRET_KEY=change-me
# Optional overrides (defaults shown).
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_GRACE_SECONDS=30
# INVITE_TTL_DAYS=7
# REFRESH_COOKIE_NAME=lumior_refresh
