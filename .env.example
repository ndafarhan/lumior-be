# Copy to .env for local development.
ENVIRONMENT=development
# Host port for the docker-compose database (5433 avoids clashing with a native PostgreSQL).
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lumior:lumior@localhost:5433/lumior
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
SECRET_KEY=change-me
